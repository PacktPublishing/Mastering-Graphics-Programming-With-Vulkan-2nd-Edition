    //uint8_t triangle_count;
    uint    packed_counts;
};


// Helper to unpack cone_axis (x, y, z) and cone_cutoff
int4 unpackConeData(uint data) {
    int x = int(data & 0xFF);
    int y = int((data >> 8) & 0xFF);
    int z = int((data >> 16) & 0xFF);
    int cutoff = int((data >> 24) & 0xFF);

    // Convert signed bytes (if needed)
    x = (x << 24) >> 24;
    y = (y << 24) >> 24;
    z = (z << 24) >> 24;
    cutoff = (cutoff << 24) >> 24;

    return int4(x, y, z, cutoff);
}

// Helper to unpack vertex and triangle counts
uint2 unpackCounts(uint data) {
    uint vtx = data & 0xFF;
    uint tri = (data >> 8) & 0xFF;
    return uint2(vtx, tri);
}

float3 unpack_normal(uint normal_packed) {
    float3 n = float3(
        float(normal_packed & 0xFF),
        float((normal_packed >> 8) & 0xFF),
        float((normal_packed >> 16) & 0xFF)
    );
    return normalize(n * (2.0 / 255.0) - 1.0);
}

float3 unpack_tangent(uint tangent_packed) {
    float3 t = float3(
        float(tangent_packed & 0xFF),
        float((tangent_packed >> 8) & 0xFF),
        float((tangent_packed >> 16) & 0xFF)
    );
    return normalize(t * (2.0 / 255.0) - 1.0);
}

float2 unpack_uv(uint packed_half2) {
    uint lo = packed_half2 & 0xFFFF;
    uint hi = (packed_half2 >> 16) & 0xFFFF;

    return float2(f16tof32(lo), f16tof32(hi));
}